{
  "name": "grpc-cli",
  "version": "0.1.0",
  "description": "grpc-cli",
  "main": "dist/src/index.js",
  "license": "MIT",
  "scripts": {
    "start": "cross-env NODE_ENV=dev nodemon ./src/index.ts ts-node ./src/index.ts",
    "eslint": "eslint ./src/**/*.ts --fix",
    "i": "npm install --registry=https://registry.npmmirror.com",
    "build": "npx tsc",
    "dev": "node ./dist/src/index.js",
    "nodemon": "nodemon -e ts,json  -L src/index.ts",
    "test": "jest --coverage",
    "cp": "node ./copy.js",
    "format": "prettier --config .prettierrc ./src/**/*.ts --write"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.2.0",
    "@grpc/grpc-js-xds": "^1.2.0",
    "@grpc/proto-loader": "^0.5.0",
    "@koa/router": "^10.1.1",
    "@types/node-schedule": "^2.1.0",
    "axios": "^0.27.2",
    "google-protobuf": "^3.19.1",
    "ioredis": "^5.3.2",
    "joi": "^17.6.0",
    "koa": "^2.13.4",
    "koa-body": "^4.2.0",
    "koa-logger": "^3.2.1",
    "koa-static": "^5.0.0",
    "md5": "^2.3.0",
    "moment": "^2.29.3",
    "node-schedule": "^2.1.0",
    "ts-node": "^10.8.0",
    "winston": "^3.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jest": "^27.4.1",
    "@types/koa": "^2.13.4",
    "@types/koa-logger": "^3.1.2",
    "@types/supertest": "^2.0.12",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^4.28.3",
    "@typescript-eslint/parser": "^4.28.3",
    "cross-env": "^7.0.3",
    "dotenv": "^10.0.0",
    "eslint": "^7.31.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-standard": "^16.0.3",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-promise": "^5.1.0",
    "grpc_tools_node_protoc_ts": "^5.3.2",
    "jest": "^27.3.1",
    "nodemon": "^2.0.12",
    "prettier": "^2.5.1",
    "supertest": "^6.2.2",
    "ts-jest": "^27.0.7",
    "typescript": "^4.5.4"
  }
}
