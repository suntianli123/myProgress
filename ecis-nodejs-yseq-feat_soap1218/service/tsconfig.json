{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2018",
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "noStrictGenericChecks": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "experimentalDecorators": true,
    "outDir": "dist",
    "allowJs": true
  },
  "include": [
    "src/**/*",
    "ecissdk/**/*"
  ]
}
